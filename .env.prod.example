# Production Environment Variables
# Usage: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

MONGO_URL=mongodb://mongo:27017/app?replicaSet=rs0&directConnection=true
MONGO_URL_AUDIT=mongodb://mongo:27017/tablemitra_audit?replicaSet=rs0&directConnection=true
MONGO_URL_ANALYTICS=mongodb://mongo:27017/tablemitra_analytics?replicaSet=rs0&directConnection=true

REDIS_URL=redis://redis:6379

RABBITMQ_URL=amqp://rabbitmq:5672

# Optional port overrides
API_PORT=5000
AUDIT_PORT=5001
ANALYTICS_PORT=5002
